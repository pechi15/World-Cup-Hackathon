# Mode A: guaranteed replay demo
DATA_MODE=replay
DEMO_MODE=true
THEO_MODE=market_baseline
TRADING_MODE=paper
ENABLE_REAL_EXECUTION=false
ENABLE_WALLET_OPERATIONS=false
ENABLE_TXODDS_ACTIVATION=false

# Mode B: live read-only paper maker (use these values instead of replay values)
# DATA_MODE=txline
# DEMO_MODE=false
