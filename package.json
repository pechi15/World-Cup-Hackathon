{
  "name": "world-cup-market-making-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx apps/api/src/server.ts",
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:web": "vite --host 0.0.0.0 --config apps/web/vite.config.ts",
    "demo": "tsx apps/api/src/server.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "@tanstack/react-query": "^5.90.12",
    "lucide-react": "^0.561.0",
    "recharts": "^3.6.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.20.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "jsdom": "^27.3.0",
    "npm-run-all": "^4.1.5",
    "@playwright/test": "^1.57.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.15"
  }
}
